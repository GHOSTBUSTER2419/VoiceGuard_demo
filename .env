# ============================================================
# VoiceGuard Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---------- Application ----------
APP_NAME=VoiceGuard
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
# Set to empty string to disable auth in development
VOICEGUARD_API_KEY=

# ---------- Model Mode ----------
# "demo" = deterministic simulated scores (no ML weights needed)
# "production" = real ML model inference
MODEL_MODE=demo

# ---------- Database ----------
# For local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./voiceguard.db
# For Docker/production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://voiceguard:voiceguard@postgres:5432/voiceguard

# ---------- Redis ----------
# Set to empty to use in-memory fallback
REDIS_URL=
# For Docker:
# REDIS_URL=redis://redis:6379/0

# ---------- Risk Thresholds (defaults) ----------
DEFAULT_RISK_THRESHOLD=70
DEFAULT_WORKFLOW=otp

# ---------- Fusion Weights ----------
SPECTRAL_WEIGHT=0.40
PROSODY_WEIGHT=0.30
SPEAKER_WEIGHT=0.30

# ---------- EMA Smoothing ----------
EMA_ALPHA=0.3

# ---------- Session ----------
SESSION_TTL_SECONDS=3600

# ---------- Privacy ----------
FEATURE_RETENTION_DAYS=90
AUDIT_ENABLED=true

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
